<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Web.Charts</PackageId>
    <Description>The web rendering of NE.Standard.UI.Charts: the charts as SVG built on the server, and the engine that re-lays them out at the size they are drawn, takes their collection as values and answers the pointer. Register it with services.AddCharts().</Description>
    <PackageTags>NE.Standard,UI,Web,Charts,Chart,SVG</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NE.Standard.UI.Charts\NE.Standard.UI.Charts.csproj" />
  </ItemGroup>

  <!-- The framework is a sibling in the monorepo and a package in this slice's mirror. Either way the produced nupkg depends on
       the framework's rendering foundation at $(CoreVersion): a chart draws its own content and derives from no built-in renderer,
       so the foundation is enough. -->
  <ItemGroup Condition="'$(InMonorepo)' == 'true'">
    <ProjectReference Include="..\..\..\..\src\Platforms\Web\NE.Standard.UI.Web.Renderers.Foundation\NE.Standard.UI.Web.Renderers.Foundation.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InMonorepo)' != 'true'">
    <PackageReference Include="NE.Standard.UI.Web.Renderers.Foundation" Version="$(CoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Client\dist\**" />
    <Content Remove="Client\dist\**" />
    <None Remove="Client\node_modules\**" />
  </ItemGroup>

  <PropertyGroup>
    <ChartsClientJs>$(MSBuildProjectDirectory)\Client\dist\ui-charts.js</ChartsClientJs>
    <ChartsClientCss>$(MSBuildProjectDirectory)\Client\dist\ui-charts.css</ChartsClientCss>
  </PropertyGroup>

  <!-- The client builds as part of dotnet build, as the framework's own does: a type error or a failing test fails the build. -->
  <Target Name="BuildChartsClientAssets" BeforeTargets="PrepareResources" Condition="'$(SkipWebClientBuild)' != 'true'">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\Client"
      Command="npm install"
      Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')" />

    <!-- Tests run here rather than from `npm run build`, as the framework's client does: a mirror builds, it
         does not test. -->
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\Client"
      Command="npm test"
      Condition="'$(InMonorepo)' == 'true'" />

    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\Client"
      Command="npm run build" />

    <Error Condition="!Exists('$(ChartsClientJs)')" Text="Charts client script was not generated: $(ChartsClientJs)" />
    <Error Condition="!Exists('$(ChartsClientCss)')" Text="Charts client stylesheet was not generated: $(ChartsClientCss)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(ChartsClientJs)" LogicalName="NE.Standard.UI.Web.Charts.Client.dist.ui-charts.js" />
    <EmbeddedResource Include="$(ChartsClientCss)" LogicalName="NE.Standard.UI.Web.Charts.Client.dist.ui-charts.css" />
  </ItemGroup>

</Project>
