{
    "note": "The arithmetic both ports have to agree on, case by case, with the answer written out. The browser's tests read this file and so does NE.Test.Standard.UI.Charts, so a change to one port that the other did not get fails on both sides. The answers are the ones the browser's own tests already pinned by hand; a number is compared to nine decimals, a path string exactly. A moment is here too: both ports number it by the wall clock it is written with, since a round step has to land on a round clock reading on both. A name is not, its number being the order the rows happened to arrive in.",
    "moments": [
        { "case": "the epoch itself", "text": "1970-01-01T00:00:00.000", "written": { "year": 1970, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0, "millisecond": 0 }, "expected": 0 },
        { "case": "a moment is the wall clock it is written with, whatever zone the reader sits in", "text": "1970-01-01T00:00:10.000", "written": { "year": 1970, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 10, "millisecond": 0 }, "expected": 10000 },
        { "case": "a zone the text carries is no part of the number", "text": "1970-01-01T00:00:10.000Z", "written": { "year": 1970, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 10, "millisecond": 0 }, "expected": 10000 },
        { "case": "a date with no clock on it", "text": "2026-09-13", "written": { "year": 2026, "month": 9, "day": 13, "hour": 0, "minute": 0, "second": 0, "millisecond": 0 }, "expected": 1789257600000 },
        { "case": "a day of the month, to the minute", "text": "2026-09-13T14:35", "written": { "year": 2026, "month": 9, "day": 13, "hour": 14, "minute": 35, "second": 0, "millisecond": 0 }, "expected": 1789310100000 },
        { "case": "a space where the T would be", "text": "2026-09-13 14:35:09.250", "written": { "year": 2026, "month": 9, "day": 13, "hour": 14, "minute": 35, "second": 9, "millisecond": 250 }, "expected": 1789310109250 },
        { "case": "an offset the text carries is no part of the number either", "text": "2026-09-13T14:35+05:00", "written": { "year": 2026, "month": 9, "day": 13, "hour": 14, "minute": 35, "second": 0, "millisecond": 0 }, "expected": 1789310100000 },
        { "case": "text that names no moment", "text": "not a moment", "expected": null },
        { "case": "a moment with a tail that is neither a clock nor a zone is no moment", "text": "2026-09-13XYZ", "expected": null },
        { "case": "a field outside its own range names no moment, rather than the day it would roll on to", "text": "2026-02-30T10:00", "expected": null }
    ],
    "ranges": [
