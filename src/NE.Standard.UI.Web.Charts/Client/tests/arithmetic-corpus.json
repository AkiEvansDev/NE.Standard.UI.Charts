        { "case": "an end the author fixed stands", "kind": "Linear", "min": 2, "max": 48, "ticks": 5, "dataMin": 3, "dataMax": 47, "categories": 0, "includeZero": false, "expected": { "min": 2, "max": 48, "logarithmic": false } },
        { "case": "no data at all still has width", "kind": "Linear", "min": null, "max": null, "ticks": 5, "dataMin": null, "dataMax": null, "categories": 0, "includeZero": false, "expected": { "min": 0, "max": 1, "logarithmic": false } },
